+    @staticmethod
+    def _node_source_segment(source: str, node: ast.AST) -> str | None:
+        """取任意节点（类成员 / 模块级定义）的完整源码，**含装饰器**，并 dedent 到深度 0。
+
+        不能复用 `_normalized_segment`：Python 3.8+ 里 FunctionDef.lineno 指向 `def`
+        那一行，装饰器只存在于 decorator_list，`ast.get_source_segment` 会把
+        `@staticmethod` / `@torch.no_grad()` 之类静默丢掉。
+        """
+        lines = source.splitlines()
+        start = getattr(node, "lineno", 1)
+        for dec in getattr(node, "decorator_list", None) or []:
+            start = min(start, getattr(dec, "lineno", start))
+        end = getattr(node, "end_lineno", None) or getattr(node, "lineno", 1)
+        segment = "\n".join(lines[start - 1:end])
+        return textwrap.dedent(segment).strip("\n") or None
+
+    @staticmethod
+    def _referenced_names(segments: list[str]) -> set[str]:
+        """收集若干代码片段里出现的全部裸名字。
+
+        含局部名也无妨 —— 宁可多带一个模块级定义，也不能漏（漏了就是 NameError）。
+        """
+        names: set[str] = set()
+        for segment in segments:
+            if not segment:
+                continue
+            try:
+                tree = ast.parse(textwrap.dedent(segment))
+            except SyntaxError:
+                continue
+            for node in ast.walk(tree):
+                if isinstance(node, ast.Name):
+                    names.add(node.id)
+        return names
+
+    @staticmethod
+    def _defined_names(node: ast.AST) -> list[str]:
+        """模块级节点定义出来的名字（函数 / 类名、赋值目标）。"""
+        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+            return [node.name]
+        if isinstance(node, ast.Assign):
+            out: list[str] = []
+            for target in node.targets:
+                out.extend(e.id for e in ast.walk(target) if isinstance(e, ast.Name))
+            return out
+        if isinstance(node, ast.AnnAssign) and isinstance(node.target, ast.Name):
+            return [node.target.id]
+        return []
+
+    @staticmethod
+    def _extract_module_helpers(source: str, module: ast.Module, wanted: set[str]) -> list[str]:
+        """把 Model 依赖的**模块级**定义（函数 / 常量 / 辅助类）原样带进脚手架。
+
+        为什么要：`_extract_imports` 只取 Import/ImportFrom，模块级的 def 与赋值全都
+        进不了脚手架，forward 一调用就
+        `NameError: name '_dequant_mxfp4' is not defined`（真机实测 3006_moe_op_mxfp4
+        与 4005_fused_mxfp4_quant 的 root 都因此跑不起来，best 只能靠 Agent 自己绕）。
+
+        取法：从 class 各片段直接引用的名字出发求**闭包** —— 被选中的定义内部引用到的
+        模块级名字也要带上（3006 的 `_dequant_mxfp4` 内部用 `_E2M1_TABLE`），
+        最后按原文件顺序输出。
+        """
+        by_name: dict[str, ast.AST] = {}
+        for node in module.body:
+            for name in KernelBenchLoader._defined_names(node):
+                by_name.setdefault(name, node)
+
+        selected: list[ast.AST] = []
+        seen_ids: set[int] = set()
+        seen_names: set[str] = set()
+        queue = list(wanted)
+        while queue:
+            name = queue.pop()
+            if name in seen_names:
+                continue
+            seen_names.add(name)
+            node = by_name.get(name)
+            if node is None or id(node) in seen_ids:
+                continue
+            seen_ids.add(id(node))
+            selected.append(node)
+            queue.extend(n.id for n in ast.walk(node) if isinstance(n, ast.Name))
+
+        order = {id(node): index for index, node in enumerate(module.body)}
+        selected.sort(key=lambda node: order[id(node)])
+        out: list[str] = []
+        for node in selected:
+            segment = KernelBenchLoader._node_source_segment(source, node)
+            if segment:
+                out.append(segment)
+        return out
+
+    @staticmethod
+    def _append_module_helpers(parts: list[str], info: ProblemInfo) -> None:
+        """把 module_helpers 原样插进脚手架（imports 之后、类定义之前）。"""
+        for block in info.module_helpers:
+            parts.extend(block.splitlines())
+            parts.append("")
+
+    @staticmethod
+    def _extract_extra_methods(source: str, class_node: ast.ClassDef) -> list[str]:
+        """Model 上除 __init__ / forward 之外的成员方法，原样保留。
+
+        为什么必须有：多个 Model 把核心计算放在私有辅助方法里（样板：
+        `5004_deform_conv2d_bwd` 的 `Model._deform_conv2d_forward`、
+        `5009_conv_depthtospace` 的 `Model._depth_to_space`），forward 通过
+        `self._xxx(...)` 调用它们。脚手架只输出 __init__ + forward 的话，ModelNew
+        上就没有这些方法，root 节点直接报
+        `AttributeError: 'ModelNew' object has no attribute '_deform_conv2d_forward'`，
+        整道题失去可比基线。
+        """
+        out: list[str] = []
+        for node in class_node.body:
+            if not isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                continue
+            if node.name in ("__init__", "forward"):
+                continue
+            segment = KernelBenchLoader._node_source_segment(source, node)
+            if segment:
+                out.append(segment)
+        return out
+
     @staticmethod
     def _normalized_segment(source: str, node: ast.AST) -> str | None:
         """取节点的源码片段，并把缩进归一化到"该节点自身深度为 0"。
