index d049d63..17a5ac5 100644
--- a/pyramidkernel/providers/errors.py
+++ b/pyramidkernel/providers/errors.py
@@ -55,6 +55,12 @@ TRANSIENT_ERROR_TOKENS = (
     "ssl",
     "response is not valid json",
     "invalid json",
+    # 2026-10-20: provider 偶发返回 200 + 空 body，客户端抛 json 解析错。
+    # 之前这类错误被当成不可重试，整道题直接报废（一轮 66 题丢了 5 道）。
+    "unable to parse json object",
+    "expecting value",
+    "jsondecodeerror",
+    "json decode error",
     "stream returned no json events",
     "response content is empty",
     "empty reply from server",
diff --git a/pyramidkernel/providers/http_utils.py b/pyramidkernel/providers/http_utils.py
index 8c6e353..c37a3f2 100644
--- a/pyramidkernel/providers/http_utils.py
+++ b/pyramidkernel/providers/http_utils.py
@@ -123,3 +123,28 @@ def _normalize_stream_line(raw_line: Any) -> str:
 
 def _connect_timeout_seconds(timeout_seconds: int) -> float:
     return min(20.0, max(1.0, float(timeout_seconds)))
+
+
+def probe_models_endpoint(
+    *,
+    base_url: str,
+    api_key: str,
+    timeout_seconds: int = 20,
+) -> tuple[bool, str]:
+    """GET {base_url}/models 作为端点可达性探测。
+
+    刻意做得比一次真实补全便宜得多：隧道断了会立刻 connection refused，
+    鉴权/余额问题会立刻 401/402/429，而正常情况只是一次几十字节的响应。
+    """
+    url = base_url.rstrip("/") + "/models"
+    headers = {
+        "Authorization": f"Bearer {api_key}",
+        "User-Agent": "pyramidkernel-healthcheck/1.0",
+    }
+    try:
+        response = requests.get(url, headers=headers, timeout=(5, max(5, timeout_seconds)))
+    except Exception as exc:  # noqa: BLE001 - 探测不能抛，只回报
+        return False, f"{type(exc).__name__}: {str(exc)[:200]}"
+    if response.status_code == 200:
+        return True, ""
+    return False, f"HTTP {response.status_code}: {str(response.text)[:200]}"
diff --git a/pyramidkernel/providers/openai_provider.py b/pyramidkernel/providers/openai_provider.py
index a5d8abc..a1be9cc 100644
--- a/pyramidkernel/providers/openai_provider.py
+++ b/pyramidkernel/providers/openai_provider.py
@@ -20,7 +20,7 @@ from ..semantics import semantic_profile_to_prompt_dict
 from ..utils import extract_anchor_names
 from .base_provider import AgentProvider
 from .errors import is_transient_provider_error
-from .http_utils import post_json_request, stream_json_events_request
+from .http_utils import post_json_request, probe_models_endpoint, stream_json_events_request
 
 
 @dataclass
@@ -52,6 +52,14 @@ class OpenAICompatibleProvider(AgentProvider):
 
     name = "openai-compatible"
 
+    def health_check(self) -> tuple[bool, str]:
+        """探一次 /models；batch 每开一题之前都会调用（见 cli 的 preflight）。"""
+        return probe_models_endpoint(
+            base_url=self.config.base_url,
+            api_key=self.config.api_key,
+            timeout_seconds=min(20, int(getattr(self.config, "timeout_seconds", 20) or 20)),
+        )
+
     def __init__(self, config: OpenAICompatibleConfig) -> None:
         self.config = self._normalize_config(config)
 
diff --git a/pyramidkernel/providers/role_router.py b/pyramidkernel/providers/role_router.py
index 300ddef..c9e5df5 100644
--- a/pyramidkernel/providers/role_router.py
+++ b/pyramidkernel/providers/role_router.py
@@ -23,6 +23,18 @@ class RoleRoutedProvider(AgentProvider):
         self.debug_provider = debug_provider
         self.search_provider = search_provider or code_provider
 
+    def health_check(self) -> tuple[bool, str]:
+        """任一角色 provider 不可达就判负，避免部分角色静默空转。"""
+        seen, failures = set(), []
+        for provider in (self.plan_provider, self.code_provider, self.debug_provider, self.search_provider):
+            if id(provider) in seen:
+                continue
+            seen.add(id(provider))
+            ok, detail = provider.health_check()
+            if not ok:
+                failures.append(f"{getattr(provider, 'name', 'provider')}: {detail}")
+        return (not failures), "; ".join(failures)
+
     def propose_plan(self, task: TaskSpec, node: SearchNode, context: AgentContext) -> PlanProposal:
         return self.plan_provider.propose_plan(task, node, context)
 
