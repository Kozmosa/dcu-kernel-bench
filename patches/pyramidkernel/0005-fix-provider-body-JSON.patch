 pyramidkernel/providers/base_provider.py   | 10 +++++++++
 pyramidkernel/providers/errors.py          |  6 ++++++
 pyramidkernel/providers/http_utils.py      | 25 ++++++++++++++++++++++
 pyramidkernel/providers/openai_provider.py | 10 ++++++++-
 pyramidkernel/providers/role_router.py     | 12 +++++++++++
 6 files changed, 86 insertions(+), 1 deletion(-)

diff --git a/pyramidkernel/cli.py b/pyramidkernel/cli.py
index 1ad29e0..5c68c32 100644
--- a/pyramidkernel/cli.py
+++ b/pyramidkernel/cli.py
@@ -784,8 +784,32 @@ def _run_kernelbench_batch(args: argparse.Namespace) -> int:
     deliberation_runner = _build_deliberation_runner(args, run_name, batch_config)
     provider = _build_provider(args, run_name)
     rows: list[dict[str, Any]] = []
+    # 2026-10-20: 死端点不会让 batch 报错。每题会把 provider 瞬时错误预算烧光，
+    # 然后落在未改动的 root 节点上，写出一份 attempt_count=0 但格式合法的
+    # run.json —— 整轮 66 题可能就此白跑（实际发生过）。所以每开一题之前先探活，
+    # 探不到就直接中止分片并返回非零，让外层的看门狗能看到。
+    preflight_failures = 0
     try:
         for item in manifest["tasks"]:
+            try:
+                healthy, detail = provider.health_check()
+            except Exception as exc:  # noqa: BLE001 - 探测本身不能把批处理打断
+                healthy, detail = False, f"health_check raised {type(exc).__name__}: {exc}"
+            if not healthy:
+                preflight_failures += 1
+                print(
+                    f"[preflight] provider unreachable before {item.get('alias', item)}: {detail}",
+                    file=sys.stderr,
+                    flush=True,
+                )
+                if preflight_failures >= 2:
+                    print(
+                        "[preflight] aborting batch: endpoint is down, remaining tasks would "
+                        "only burn their transient-error budget and produce root-only results.",
+                        file=sys.stderr,
+                        flush=True,
+                    )
+                    return 3
             level = int(item["level"])
             problem_id = int(item["problem_id"])
             alias = str(item.get("alias") or f"L{level}_P{problem_id}")
diff --git a/pyramidkernel/providers/base_provider.py b/pyramidkernel/providers/base_provider.py
index 75ec1d2..e96e46e 100644
--- a/pyramidkernel/providers/base_provider.py
+++ b/pyramidkernel/providers/base_provider.py
@@ -13,6 +13,16 @@ class AgentProvider(ABC):
 
     name = "provider"
 
+    def health_check(self) -> tuple[bool, str]:
+        """廉价可达性探测，供批量跑在**开题之前**判活。
+
+        死端点（隧道断了、余额耗尽、鉴权失效）不会让 batch 失败：每题会把
+        provider 瞬时错误预算烧光，然后落在未改动的 root 节点上，写出一份
+        attempt_count=0 但格式完全合法的 run.json —— 整轮可能就此白跑。
+        返回 (False, detail) 让批处理直接中止分片，而不是继续产出假结果。
+        """
+        return True, ""
+
     @abstractmethod
     def propose_plan(self, task: TaskSpec, node: SearchNode, context: AgentContext) -> PlanProposal:
         raise NotImplementedError
