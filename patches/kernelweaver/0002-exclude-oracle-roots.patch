diff --git a/tests/test_oracle_boundary.py b/tests/test_oracle_boundary.py
new file mode 100644
index 0000000..6bcfce8
--- /dev/null
+++ b/tests/test_oracle_boundary.py
@@ -0,0 +1,91 @@
+"""Oracle roots are baselines, never submitted search results."""
+import tempfile
+import unittest
+from pathlib import Path
+
+from src.core.tree import TreeMemory
+from src.core.workflow import _evaluate_generated, _evaluation_to_root_node, _finalize_run
+from src.models import EvaluationResult, PlanProposal, StarkConfig
+from src.io import save_run, load_run
+from src.demo import build_demo_tasks
+
+
+class OracleBoundaryTests(unittest.TestCase):
+    def setup_tree(self):
+        self.config = StarkConfig(max_attempts=2)
+        self.task = build_demo_tasks()[0]
+        root = _evaluation_to_root_node(self.task.source_code, EvaluationResult(True, True, 1.0, 1.0))
+        tree = TreeMemory(root, self.config)
+        tree.update_leaderboard('root', self.config)
+        return tree
+
+    def add(self, tree, correct=True, score=12.6, code='generated'):
+        proposal = PlanProposal('test', 'test', [], 'test')
+        ev = EvaluationResult(True, correct, score if correct else None, score,
+                              failure_stage='none' if correct else 'correctness')
+        node = tree.add_child('root', code, proposal, ev, 'plan_code')
+        tree.update_leaderboard(node.node_id, self.config)
+        return node
+
+    def finish(self, tree):
+        return _finalize_run(self.task, self.config, tree, {}, {}, [], [], [], "stark")
+
+    def test_slower_generated_solution_beats_oracle_for_submission(self):
+        tree = self.setup_tree()
+        child = self.add(tree)
+        self.assertEqual(tree.leaderboard, [child.node_id])
+        self.assertEqual(self.finish(tree).best_node_id, child.node_id)
+
+    def test_no_valid_candidate_is_explicit_and_never_exports_root(self):
+        tree = self.setup_tree()
+        self.add(tree, correct=False, score=float('inf'))
+        result = self.finish(tree)
+        self.assertIsNone(result.best_node_id)
+        self.assertEqual(result.stats['search_status'], 'no_valid_candidate')
+        with tempfile.TemporaryDirectory() as tmp:
+            stale = Path(tmp) / 'best_code.py'
+            stale.write_text('old success')
+            run_path = save_run(result, tmp)
+            self.assertFalse(stale.exists())
+            loaded = load_run(run_path)
+            self.assertIsNone(loaded.best_node_id)
+            self.assertIn('root', loaded.nodes)
+            self.assertIn('n1', loaded.nodes)
+
+    def test_fastest_real_candidate_wins(self):
+        tree = self.setup_tree()
+        self.add(tree, score=5, code='slow')
+        fast = self.add(tree, score=2, code='fast')
+        self.assertEqual(self.finish(tree).best_node_id, fast.node_id)
+
+    def test_phase_two_root_and_unchanged_scaffold_are_excluded(self):
+        tree = self.setup_tree()
+        node = self.add(tree, score=0.1, code=tree.nodes['root'].code)
+        self.assertEqual(tree.leaderboard, [])
+        node.code = 'phase-two baseline'
+        node.origin = 'phase2_root'
+        tree.update_leaderboard(node.node_id, self.config)
+        self.assertEqual(tree.leaderboard, [])
+        self.assertIsNone(self.finish(tree).best_node_id)
+
+    def test_unchanged_root_is_failed_before_evaluation(self):
+        tree = self.setup_tree()
+        class MustNotRun:
+            def evaluate(self, *args):
+                raise AssertionError("oracle entered candidate evaluator")
+        result = _evaluate_generated(self.task, self.task.source_code, self.config, MustNotRun())
+        self.assertFalse(result.correct)
+        self.assertEqual(result.failure_type, "oracle_not_candidate")
+
+    def test_export_rejects_manually_selected_root(self):
+        tree = self.setup_tree()
+        result = self.finish(tree)
+        result.best_node_id = 'root'
+        with tempfile.TemporaryDirectory() as tmp:
+            path = save_run(result, tmp)
+            self.assertIsNone(load_run(path).best_node_id)
+            self.assertFalse((Path(tmp) / 'best_code.py').exists())
+
+
+if __name__ == '__main__':
+    unittest.main()
